{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/signin",
      "destination": "/login.html"
    },
    {
      "source": "/sign-in",
      "destination": "/login.html"
    },
    {
      "source": "/register",
      "destination": "/register.html"
    },
    {
      "source": "/signup",
      "destination": "/register.html"
    },
    {
      "source": "/sign-up",
      "destination": "/register.html"
    },
    {
      "source": "/google-auth",
      "destination": "/google-auth.html"
    },
    {
      "source": "/social-auth",
      "destination": "/social-auth.html"
    },
    {
      "source": "/profile",
      "destination": "/profile.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/write",
      "destination": "/write.html"
    },
    {
      "source": "/presentation",
      "destination": "/presentation.html"
    },
    {
      "source": "/blog/:slug*",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/(.*)",
      "destination": "/blog.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    }
  ]
}
