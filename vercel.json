{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/login",
      "destination": "/public/login.html"
    },
    {
      "source": "/signin",
      "destination": "/public/login.html"
    },
    {
      "source": "/sign-in",
      "destination": "/public/login.html"
    },
    {
      "source": "/register",
      "destination": "/public/register.html"
    },
    {
      "source": "/signup",
      "destination": "/public/register.html"
    },
    {
      "source": "/sign-up",
      "destination": "/public/register.html"
    },
    {
      "source": "/google-auth",
      "destination": "/public/google-auth.html"
    },
    {
      "source": "/social-auth",
      "destination": "/public/social-auth.html"
    },
    {
      "source": "/profile",
      "destination": "/public/profile.html"
    },
    {
      "source": "/admin",
      "destination": "/public/admin.html"
    },
    {
      "source": "/write",
      "destination": "/public/write.html"
    },
    {
      "source": "/presentation",
      "destination": "/public/presentation.html"
    },
    {
      "source": "/blog/:slug*",
      "destination": "/public/blog.html"
    },
    {
      "source": "/blog/(.*)",
      "destination": "/public/blog.html"
    },
    {
      "source": "/blog",
      "destination": "/public/blog.html"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/public/:path*"
    }
  ]
}
