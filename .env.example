# ===================================================================
# ApexBlog / TownTalk Production & Local Environment Configuration
# ===================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# ===================================================================
# Supabase PostgreSQL & Prisma Database Connection
# ===================================================================
# For Supabase: Project Settings -> Database -> Connection string (URI)
# Use the pooled connection (port 6543) or direct connection (port 5432):
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ===================================================================
# Security & JWT Authentication
# ===================================================================
# Generate a strong 32+ character random secret for production (e.g., openssl rand -base64 32)
JWT_SECRET=your_production_jwt_secret_minimum_32_characters_long

# ===================================================================
# Deployment URLs & CORS Configuration
# ===================================================================
# FRONTEND_URL: Used by the Render backend to allow cross-origin requests from Vercel
FRONTEND_URL=https://your-blog-frontend.vercel.app

# VITE_API_URL: Used by the frontend client to route API calls to the Render backend
VITE_API_URL=https://your-blog-backend.onrender.com

# ===================================================================
# Media Uploads & Cloud Storage (Fix for Render Ephemeral Filesystem)
# ===================================================================
# Choose Option 1 (Cloudinary Free Tier) or Option 2 (Supabase Storage)
# If left empty, uploads fall back to local disk (public/uploads/)

# Option 1: Cloudinary Free Tier (https://cloudinary.com)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Option 2: Supabase Storage Bucket (https://supabase.com)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_KEY=your_supabase_anon_or_service_role_key
# SUPABASE_STORAGE_BUCKET=blog-uploads

# ===================================================================
# Email Delivery Configuration (Nodemailer - OTP / Password Reset)
# ===================================================================
# Option 1: Gmail App Password (https://myaccount.google.com/apppasswords)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password

# Option 2: Custom SMTP (Brevo, SendGrid, Mailgun, AWS SES, etc.)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_login
# SMTP_PASS=your_smtp_password
# SMTP_FROM="ApexBlog Security" <security@yourdomain.com>

# ===================================================================
# Google OAuth 2.0 Configuration (Optional - Mock Sandbox built-in)
# ===================================================================
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-blog-backend.onrender.com/auth/google/callback
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_AUTH_MOCK=false
